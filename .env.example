# Smart Campus EMS 環境變數範例（全部是假值）
#
# ⚠ 本專案「不會」自動讀取 .env 檔。這份是後端需要的環境變數清單，用法：
#   - 本機開發：通常不需要，appsettings.Development.json 已有開發用假值；
#     連線不同時在 PowerShell 設定，例：$env:ConnectionStrings__DefaultConnection = "Host=...;Password=..."
#   - WSL 部署：deploy/wsl/install.sh 第一次執行會自動產生 /etc/ems/ems.env（root 600，格式同本檔）
# ASP.NET Core 的設定階層 ':' 在環境變數寫成 '__'。

# install.sh 與 backfill.sh 用的 DB 密碼（跟連線字串裡的 Password 同一組）
EMS_DB_PASSWORD=change-me

# 後端（ASP.NET Core：階層的 ':' 在環境變數寫成 '__'）
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=ems;Username=ems;Password=change-me
Jwt__SignKey=change-me-to-a-random-string-at-least-32-chars

# Demo 預設帳號的初始密碼：只在資料庫還沒有該帳號時使用；沒設就不建立該帳號
Seed__AdminPassword=change-me
Seed__ViewerPassword=change-me
Seed__SysadminPassword=change-me
